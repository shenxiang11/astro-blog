---
import { getEntry, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const english = locale === "en";
const miaotieHref = getRelativeLocaleUrl(locale, "miaotie");
const tiaotiaoHref = getRelativeLocaleUrl(locale, "tiaotiao");
const librariesHref = getRelativeLocaleUrl(locale, "libraries");

const about = english ? null : await getEntry("pages", "about");
if (!english && !about) {
  throw new Error(
    "Missing content entry: `about.md` or `about.mdx` in `src/content/pages/`"
  );
}

const title = english ? "About" : about!.data.title;
const description = english ? "About Xingyao." : about!.data.description;
const rendered = about ? await render(about) : null;
const Content = rendered?.Content;
---

<Layout
  title={`${title} | ${config.site.title}`}
  {description}
  ogImage={about?.data.ogImage}
  canonicalURL={about?.data.canonicalURL}
>
  <Header />

  <Main pageTitle={title} class="app-prose">
    <Breadcrumb slot="lead" class="mb-6" />
    {
      english ? (
        <>
          <p>Xingyao is my personal site: I build apps and write notes.</p>
          <p>What I'm working on:</p>
          <ul>
            <li>
              <a href={miaotieHref}>MyPaste</a>: clipboard history for Mac /
              iPhone
            </li>
            <li>
              <a href={tiaotiaoHref}>TiaoTiao</a>: jump-rope counter
            </li>
            <li>
              <a href={librariesHref}>Libraries</a>:{" "}
              <a href="https://github.com/shenxiang11/vapkit">VAPKit</a>,{" "}
              <a href="https://github.com/shenxiang11/vapkit-android">
                VAPKit Android
              </a>
              ,{" "}
              <a href="https://github.com/shenxiang11/vapkit-web">VAPKit Web</a>,{" "}
              <a href="https://github.com/shenxiang11/NestedPaging">
                NestedPaging
              </a>
            </li>
          </ul>
        </>
      ) : (
        Content && <Content />
      )
    }
  </Main>

  <Footer />
</Layout>
