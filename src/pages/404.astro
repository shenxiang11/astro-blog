---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import NotFoundTitle from "@/components/NotFoundTitle";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.notFound.title} | ${config.site.title}`}>
  <Header />

  <main
    id="main-content"
    class="app-layout my-1 flex flex-1 items-center justify-center"
  >
    <div class="mb-14 flex flex-col items-center justify-center">
      <h1 class="sr-only">{t.notFound.title}</h1>
      <p class="sr-only">{t.notFound.message}</p>
      <div class="not-found-fuzzy" aria-hidden="true">
        <NotFoundTitle client:only="react" message={t.notFound.message} />
      </div>
      <LinkButton
        href={getRelativeLocaleUrl(locale, "")}
        class="my-6 text-lg underline decoration-dashed underline-offset-8"
      >
        {t.notFound.goHome}
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .not-found-fuzzy {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .not-found-fuzzy :global(canvas) {
    display: block;
    max-width: 100%;
    height: auto;
  }
</style>
