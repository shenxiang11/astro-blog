---
import type { MarkdownHeading } from "astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  headings: MarkdownHeading[];
};

const TOC_TITLES = new Set(["table of contents", "toc", "目录"]);

const { headings } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const items = headings.filter(
  heading =>
    heading.depth >= 2 &&
    heading.depth <= 3 &&
    !TOC_TITLES.has(heading.text.trim().toLowerCase())
);
---

{
  items.length > 0 && (
    <nav class="toc" aria-label={t.post.tableOfContents}>
      <details class="border-border bg-muted/80 mb-8 rounded-xl border px-4 py-3 xl:hidden">
        <summary class="cursor-pointer text-sm font-semibold tracking-tight">
          {t.post.tableOfContents}
        </summary>
        <ol class="mt-3 space-y-2 border-s border-border">
          {items.map(heading => (
            <li>
              <a
                href={`#${heading.slug}`}
                class:list={[
                  "text-muted-foreground hover:text-foreground block text-sm leading-snug",
                  heading.depth === 2 ? "ps-3" : "ps-6",
                ]}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </details>

      <div class="pointer-events-none absolute top-0 left-full hidden h-full pl-10 xl:block">
        <div class="pointer-events-auto sticky top-24 w-52">
          <p class="text-muted-foreground mb-3 text-xs font-semibold tracking-wide">
            {t.post.tableOfContents}
          </p>
          <ol class="border-border space-y-2.5 border-s">
            {items.map(heading => (
              <li>
                <a
                  href={`#${heading.slug}`}
                  data-toc-link={heading.slug}
                  class:list={[
                    "text-muted-foreground hover:text-foreground -ms-px block border-s border-transparent text-sm leading-snug transition-colors",
                    heading.depth === 2 ? "ps-3" : "ps-6",
                  ]}
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </nav>
  )
}

<script>
  let tocObserver: IntersectionObserver | undefined;

  function initTocSpy() {
    tocObserver?.disconnect();

    const links = [
      ...document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"),
    ];
    if (links.length === 0) return;

    const headings = links
      .map(link => document.getElementById(link.dataset.tocLink ?? ""))
      .filter((node): node is HTMLElement => node !== null);

    if (headings.length === 0) return;

    const setActive = (slug: string) => {
      for (const link of links) {
        const isActive = link.dataset.tocLink === slug;
        link.classList.toggle("text-accent", isActive);
        link.classList.toggle("border-accent", isActive);
        link.classList.toggle("text-muted-foreground", !isActive);
        link.classList.toggle("border-transparent", !isActive);
      }
    };

    tocObserver = new IntersectionObserver(
      entries => {
        const visible = entries
          .filter(entry => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        const slug = visible[0]?.target.id;
        if (slug) setActive(slug);
      },
      { rootMargin: "0px 0px -70% 0px", threshold: 0 }
    );

    headings.forEach(heading => tocObserver?.observe(heading));
    setActive(headings[0].id);
  }

  document.addEventListener("astro:page-load", initTocSpy);
</script>
