---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ToolCard from "@/components/ToolCard.astro";
import { getSortedTools } from "@/data/tools";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const items = getSortedTools(locale);
---

<Layout
  title={`${t.pages.toolsTitle} | ${config.site.title}`}
  description={t.pages.toolsDesc}
>
  <Header />

  <main id="main-content" class="flex-1">
    <section class="site-layout pt-8 pb-2 text-center sm:pt-12">
      <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">
        {t.pages.toolsTitle}
      </h1>
      <p class="text-muted-foreground mx-auto mt-5 max-w-2xl text-lg">
        {t.pages.toolsDesc}
      </p>
    </section>

    <section class="site-layout pt-10 pb-24">
      <ul class="mx-auto max-w-4xl">
        {items.map(tool => <ToolCard {tool} />)}
      </ul>
    </section>
  </main>

  <Footer />
</Layout>
