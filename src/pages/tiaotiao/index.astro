---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import AppStoreBadge from "@/components/AppStoreBadge.astro";
import TiaoTiaoCarousel from "@/components/TiaoTiaoCarousel.astro";
import { getProduct } from "@/data/products";
import config from "@/config";
import "@/styles/tiaotiao.css";

const product = getProduct("tiaotiao");
---

<Layout title={`${product.name} | ${config.site.title}`} description={product.description}>
  <Header />

  <main id="main-content" class="tiaotiao-page flex-1">
    <section class="tiaotiao-hero">
      <div class="site-layout pt-8 pb-14 text-center sm:pt-12 sm:pb-16">
        <p class="text-muted-foreground text-sm tracking-[0.2em] uppercase">
          {product.nameEn}
        </p>
        <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-6xl">
          {product.title}
        </h1>
        <p class="text-muted-foreground mx-auto mt-5 max-w-lg text-lg leading-relaxed">
          {product.description}
        </p>
        <p class="text-muted-foreground mt-4 text-sm">
          {product.platforms.join(" · ")}
        </p>
        <AppStoreBadge href={product.appStoreUrl} />
      </div>
    </section>

    <TiaoTiaoCarousel />

    <section class="tiaotiao-features">
      <div class="site-layout pt-16 pb-24">
        <h2 class="font-hand text-4xl">Features.</h2>
        <ul class="mt-8 grid gap-3 sm:grid-cols-2">
          {
            product.features.map(feature => (
              <li class="border-border/80 bg-card/60 rounded-2xl border px-5 py-4">
                {feature}
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
