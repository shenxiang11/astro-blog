---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import AppStoreBadge from "@/components/AppStoreBadge.astro";
import TiaoTiaoCarousel from "@/components/TiaoTiaoCarousel.astro";
import ProductFeatureList from "@/components/ProductFeatureList.astro";
import { getLocalizedProduct } from "@/data/products";
import config from "@/config";
import "@/styles/tiaotiao.css";

const locale = Astro.currentLocale ?? config.site.lang;
const product = getLocalizedProduct("tiaotiao", locale);
---

<Layout title={`${product.name} | ${config.site.title}`} description={product.description}>
  <Header />

  <main id="main-content" class="tiaotiao-page flex-1">
    <section class="tiaotiao-hero">
      <div class="site-layout pt-8 pb-14 text-center sm:pt-12 sm:pb-16">
        <p class="text-muted-foreground text-sm tracking-[0.2em] uppercase">
          {product.nameEn}
        </p>
        <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-6xl">
          {product.title}
        </h1>
        <p class="text-muted-foreground mx-auto mt-5 max-w-lg text-lg leading-relaxed">
          {product.description}
        </p>
        <ProductFeatureList
          features={product.features}
          class="mx-auto max-w-md text-left"
        />
        <p class="text-muted-foreground mt-4 text-sm">
          {product.platforms.join(" · ")}
        </p>
        <AppStoreBadge href={product.appStoreUrl} />
      </div>
    </section>

    <TiaoTiaoCarousel />
  </main>

  <Footer />
</Layout>
