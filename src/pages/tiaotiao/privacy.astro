---
import { getEntry, render } from "astro:content";
import LegalLayout from "@/layouts/LegalLayout.astro";

const privacy = await getEntry("pages", "tiaotiao-privacy");

if (!privacy) {
  throw new Error(
    "Missing content entry: `tiaotiao-privacy.md` in `src/content/pages/`"
  );
}

const { Content } = await render(privacy);
---

<LegalLayout
  title={privacy.data.title}
  description={privacy.data.description}
  ogImage={privacy.data.ogImage}
  canonicalURL={privacy.data.canonicalURL}
>
  <Content />
</LegalLayout>
