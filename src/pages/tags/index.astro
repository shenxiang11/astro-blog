---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { getPostsForLocale } from "@/utils/getLocalizedPosts";
import { tagLabel } from "@/utils/tagLabel";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const posts = getPostsForLocale(await getCollection("posts"), locale);
const tags = getUniqueTags(posts);
---

<Layout title={`${t.pages.tagsTitle} | ${config.site.title}`}>
  <Header />

  <Main pageTitle={t.pages.tagsTitle} pageDesc={t.pages.tagsDesc}>
    <Breadcrumb slot="lead" class="mb-6" />
    <ul class="flex flex-wrap gap-6">
      {tags.map(({ tag, tagName }) => (
        <Tag {tag} tagName={tagLabel(tagName, locale)} />
      ))}
    </ul>
  </Main>

  <Footer />
</Layout>
