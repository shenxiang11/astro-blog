---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import HeightDemo from "@/components/height-slider/HeightSlider";
import { loadDemoPage } from "@/utils/loadDemoPage";
import config from "@/config";
import "@/styles/height-slider.css";

const locale = Astro.currentLocale ?? config.site.lang;
const { title, description } = await loadDemoPage("height-slider", locale);
---

<Layout title={`${title} | ${config.site.title}`} {description}>
  <Header />

  <main id="main-content" class="hs-page flex-1">
    <HeightDemo client:only="react" locale={locale} />
  </main>
</Layout>
