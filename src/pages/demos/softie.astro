---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Softie from "@/components/softie/Softie";
import { loadDemoPage } from "@/utils/loadDemoPage";
import config from "@/config";
import "@/styles/softie.css";

const locale = Astro.currentLocale ?? config.site.lang;
const { title, description } = await loadDemoPage("softie", locale);
---

<Layout title={`${title} | ${config.site.title}`} {description}>
  <Header />

  <main id="main-content" class="softie-page flex-1">
    <Softie client:only="react" locale={locale} />
  </main>
</Layout>
