import Header from "@/components/Header.astro";
import DualRangeDemo from "@/components/dual-range-slider/DualRangeSlider";
import config from "@/config";
import "@/styles/dual-range-slider.css";
---

<Layout
  title={`Dual Range Slider | ${config.site.title}`}
