---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { TEXT_ANIMATIONS } from "@/data/textAnimations";
import { loadDemoPage } from "@/utils/loadDemoPage";
import { getDemoUi } from "@/i18n/demoUi";
import config from "@/config";
import "@/styles/text-animations.css";

const locale = Astro.currentLocale ?? config.site.lang;
const { title, description } = await loadDemoPage("text-animations", locale);
const ui = getDemoUi(locale);
---

<Layout title={`${title} | ${config.site.title}`} {description}>
  <Header />

  <main
    id="main-content"
    class="flex-1"
    data-ta-copied={ui.textCopied}
    data-ta-copied-named={ui.textCopiedNamed}
  >
    <section class="site-layout pt-8 pb-2 text-center sm:pt-12">
      <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">{title}</h1>
      <p class="text-muted-foreground mx-auto mt-5 max-w-2xl text-lg">
        {description}
      </p>
      <input
        type="text"
        class="ta-input"
        data-ta-input
        maxlength="40"
        placeholder={ui.textPlaceholder}
        autocomplete="off"
        spellcheck="false"
      />
      <div class="ta-filters" data-ta-filters>
        <button type="button" class="ta-filter is-active" data-ta-filter="all">
          {ui.textAll}
        </button>
        <button type="button" class="ta-filter" data-ta-filter="picked">
          {ui.textPicked} <span class="ta-picked-count" data-ta-picked-count>0</span>
        </button>
      </div>
    </section>

    <section class="site-layout pt-10 pb-24">
      <div class="ta-grid" data-ta-grid>
        {
          TEXT_ANIMATIONS.map((anim, index) => (
            <article class="ta-card" data-anim-id={anim.id}>
              <header class="ta-card-header">
                <h2>
                  {index + 1}. {anim.name}
                </h2>
                <button
                  type="button"
                  class="ta-pick"
                  data-ta-pick
                  title={ui.textCompare}
                  aria-label={`${ui.textStar} ${anim.name}`}
                  aria-pressed="false"
                >
                  ☆
                </button>
              </header>
              <div
                class:list={["ta-stage", { "is-overflow": anim.overflow === "visible" }]}
                data-ta-stage
              />
              <div class="ta-actions">
                <button type="button" class="ta-btn" data-ta-restart>
                  {ui.textReplay}
                </button>
                <button type="button" class="ta-btn" data-ta-copy>
                  {ui.textCopy}
                </button>
              </div>
            </article>
          ))
        }
        <p class="ta-empty" data-ta-empty>{ui.textEmpty}</p>
      </div>
    </section>
  </main>

  <div class="ta-toast" data-ta-toast role="status" aria-live="polite"></div>
  <Footer />
</Layout>

<script>
  import { initTextAnimations } from "@/scripts/text-animations";

  initTextAnimations();
  document.addEventListener("astro:after-swap", initTextAnimations);
</script>
