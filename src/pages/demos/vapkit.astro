---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import config from "@/config";
---

<Layout
  title={`VAPKit | ${config.site.title}`}
  description="用 VAPKit Web 播 VAP 礼物。点超级火箭，同一帧里的 RGB 和灰阶 Alpha 合成透明动画。"
>
  <Header />

  <main
    id="main-content"
    class="flex flex-1 items-center justify-center px-5 py-10"
  >
    <div
      class="aspect-[750/1334] w-[min(26.875rem,100%,calc((100svh-11rem)*750/1334))] overflow-hidden rounded-[1.75rem] border border-foreground/10 bg-black shadow-[0_24px_80px_rgb(0_0_0/0.28)]"
    >
      <iframe
        class="h-full w-full border-0"
        src="https://vapkit-web-demo.vercel.app/"
        title="VAPKit 直播间"
        allow="autoplay"
      ></iframe>
    </div>
  </main>
</Layout>
