---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import DustEffect from "@/components/dust-effect/DustEffect";
import { loadDemoPage } from "@/utils/loadDemoPage";
import config from "@/config";
import "@/styles/dust-effect.css";

const locale = Astro.currentLocale ?? config.site.lang;
const { title, description } = await loadDemoPage("dust-effect", locale);
---

<Layout title={`${title} | ${config.site.title}`} {description}>
  <Header />

  <main id="main-content" class="dust-page flex-1">
    <DustEffect client:only="react" locale={locale} />
  </main>
</Layout>
