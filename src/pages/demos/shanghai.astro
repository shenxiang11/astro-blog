---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import ShanghaiSketchbook from "@/components/shanghai-sketchbook/ShanghaiSketchbook";
import { loadDemoPage } from "@/utils/loadDemoPage";
import config from "@/config";
import "@/styles/shanghai-sketchbook.css";

const locale = Astro.currentLocale ?? config.site.lang;
const { title, description } = await loadDemoPage("shanghai", locale);
---

<Layout title={`${title} | ${config.site.title}`} {description}>
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;500;600&display=swap"
  />
  <Header />

  <main id="main-content" class="sh-page flex-1">
    <ShanghaiSketchbook client:only="react" locale={locale} />
  </main>
</Layout>
