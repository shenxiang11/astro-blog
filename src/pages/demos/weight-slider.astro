---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import WeightDemo from "@/components/weight-slider/WeightArcSlider";
import { loadDemoPage } from "@/utils/loadDemoPage";
import config from "@/config";
import "@/styles/weight-slider.css";

const locale = Astro.currentLocale ?? config.site.lang;
const { title, description } = await loadDemoPage("weight-slider", locale);
---

<Layout title={`${title} | ${config.site.title}`} {description}>
  <Header />

  <main id="main-content" class="ws-page flex-1">
    <WeightDemo client:only="react" locale={locale} />
  </main>
</Layout>
