---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ProfileCard from "@/components/ProfileCard.astro";
import ProductSection from "@/components/ProductSection.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import { profile } from "@/data/profile";
import { products } from "@/data/products";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const recentPosts = getSortedPosts(posts).slice(0, 4);
---

<Layout>
  <Header />

  <main id="main-content">
    <section
      class="site-layout grid items-center gap-12 pt-8 pb-16 lg:grid-cols-2 lg:gap-20 lg:pt-12 lg:pb-24"
    >
      <div>
        <h1 class="font-hand text-5xl leading-none sm:text-7xl">
          {profile.aboutTitle}
        </h1>
        <ul class="mt-10 space-y-4 text-base sm:text-lg">
          {
            profile.lines.map(line => (
              <li class="flex items-start gap-3">
                <span class="text-muted-foreground w-6 shrink-0 text-center">
                  {line.icon}
                </span>
                {line.text.includes("@") ? (
                  <a href={`mailto:${profile.email}`} class="hover:underline">
                    {line.text}
                  </a>
                ) : (
                  <span>{line.text}</span>
                )}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="flex justify-center lg:justify-end">
        <ProfileCard />
      </div>
    </section>

    {
      products.map((product, index) => (
        <ProductSection product={product} flip={index % 2 === 1} />
      ))
    }

    <section class="site-layout pb-24">
      <div class="mb-8 flex items-end justify-between gap-4">
        <h2 class="font-hand text-4xl sm:text-5xl"># Writing.</h2>
        <a
          href={getRelativeLocaleUrl(locale, "posts")}
          class="text-muted-foreground hover:text-foreground text-sm"
        >
          {t.home.allPosts}
        </a>
      </div>
      <ul>
        {recentPosts.map(data => <Card {...data} />)}
      </ul>
    </section>
  </main>

  <Footer />
</Layout>
