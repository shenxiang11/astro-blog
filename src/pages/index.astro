---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ProductSection from "@/components/ProductSection.astro";
import Card from "@/components/Card.astro";
import { getPostsForLocale } from "@/utils/getLocalizedPosts";
import { getAssetPath } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import LineSidebar from "@/components/line-sidebar/LineSidebar";
import ProfileCard from "@/components/profile-card/ProfileCard";
import TechLogoLoop from "@/components/logo-loop/TechLogoLoop";
import { getProfile } from "@/data/profile";
import { getLocalizedProducts } from "@/data/products";
import config from "@/config";
import avatarUrl from "@/assets/profile/person.webp?url";
import grainUrl from "@/assets/profile/grain.webp?url";
import "@/styles/line-sidebar.css";
import "@/styles/profile-card.css";
import "@/styles/galaxy.css";
import "@/styles/logo-loop.css";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const profile = getProfile(locale);
const localizedProducts = getLocalizedProducts(locale);

const posts = await getCollection("posts");
const recentPosts = getPostsForLocale(posts, locale).slice(0, 4);
---

<Layout>
  <div class="home-shell">
    <div id="home-galaxy" class="home-galaxy" aria-hidden="true"></div>
    <Header />

    <main id="main-content">
      <section
        class="site-layout grid items-center gap-10 pt-16 pb-16 lg:grid-cols-2 lg:justify-between lg:gap-8 lg:pt-24 lg:pb-20"
      >
        <div class="w-full min-w-0 md:max-w-lg lg:max-w-xl">
          <h1 class="font-hand text-3xl leading-none md:text-4xl">
            {profile.aboutTitle}
          </h1>
          <LineSidebar
            client:idle
            className="mt-4 md:mt-6"
            items={[
              ...profile.lines,
              ...(profile.schools.length
                ? [
                    {
                      label: "🎓  ",
                      marks: profile.schools.map(school => ({
                        src: getAssetPath(school.src),
                        alt: school.name,
                        href: school.href,
                      })),
                    },
                  ]
                : []),
              ...(profile.contacts.length
                ? [
                    {
                      label: "🌟  ",
                      marks: profile.contacts.map(contact => ({
                        src: getAssetPath(contact.src),
                        alt: contact.name,
                        href: contact.href,
                      })),
                    },
                  ]
                : []),
            ]}
            accentColor="var(--foreground)"
            textColor="var(--foreground)"
            markerColor="color-mix(in srgb, var(--foreground) 45%, transparent)"
            showIndex={false}
            showMarker
            proximityRadius={140}
            maxShift={40}
            falloff="smooth"
            markerLength={20}
            markerGap={10}
            tickScale={0.5}
            scaleTick={false}
            itemGap={50}
            smoothing={320}
            stickyActive={false}
          />
        </div>
        <div class="flex w-full justify-center lg:w-auto lg:justify-end">
          <ProfileCard
            client:load
            name={profile.name}
            title={profile.role}
            handle={profile.handle}
            status={profile.status}
            contactText={t.common.contactMe}
            contactHref={`mailto:${profile.email}`}
            avatarUrl={avatarUrl}
            iconUrl={getAssetPath("profile/iconpattern.svg")}
            grainUrl={grainUrl}
            showUserInfo
            enableTilt
            enableMobileTilt={false}
            behindGlowEnabled
            behindGlowColor="rgba(255, 255, 255, 0.7)"
            innerGradient="linear-gradient(180deg, #FF3E3E 0%, #FFD549 40%, #FFFFFF 65%, #D1E7FF 83%, #3C9AFF 100%)"
          />
        </div>
      </section>

      <section class="pb-16 lg:pb-24">
          <TechLogoLoop client:load locale={locale} />
      </section>

      {
        localizedProducts.map((product, index) => (
          <ProductSection product={product} flip={index % 2 === 1} />
        ))
      }

      <section class="site-layout pb-24">
        <div class="mb-8 flex items-end justify-between gap-4">
          <h2 class="font-hand text-4xl sm:text-5xl">{t.home.writing}</h2>
          <a
            href={getRelativeLocaleUrl(locale, "posts")}
            class="text-muted-foreground hover:text-foreground text-sm"
          >
            {t.home.allPosts}
          </a>
        </div>
        <ul>
          {recentPosts.map(data => <Card {...data} />)}
        </ul>
      </section>
    </main>

    <Footer />
  </div>

  <script>
    import "@/scripts/home-galaxy";
  </script>
</Layout>
