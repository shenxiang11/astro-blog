---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ProductFeatureList from "@/components/ProductFeatureList.astro";
import PushTesterGallery from "@/components/PushTesterGallery.astro";
import { getLocalizedProduct } from "@/data/products";
import IconBrandGithub from "@/assets/icons/socials/github.svg";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const product = getLocalizedProduct("pushtester", locale);
---

<Layout
  title={`${product.name} | ${config.site.title}`}
  description={product.description}
>
  <Header />

  <main id="main-content" class="flex-1">
    <section class="site-layout pt-8 pb-10 text-center sm:pt-12 sm:pb-12">
      <p class="text-muted-foreground text-sm tracking-[0.2em] uppercase">
        {product.nameEn}
      </p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-6xl">
        {product.title}
      </h1>
      <p class="text-muted-foreground mx-auto mt-5 max-w-lg text-lg leading-relaxed">
        {product.description}
      </p>
      <ProductFeatureList
        features={product.features}
        class="mx-auto max-w-md text-left"
      />
      <p class="text-muted-foreground mt-4 text-sm">
        {product.platforms.join(" · ")}
      </p>
      {
        product.downloadUrl && (
          <a
            href={product.downloadUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-foreground text-background mt-8 inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-medium"
          >
            <IconBrandGithub class="size-4" />
            {t.store.download}
          </a>
        )
      }
    </section>

    <PushTesterGallery />
  </main>

  <Footer />
</Layout>
