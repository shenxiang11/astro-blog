---
import type { LocalizedProduct } from "@/data/products";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  product: LocalizedProduct;
  class?: string;
};

const { product, class: className } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const privacyHref = product.privacyHref
  ? getRelativeLocaleUrl(locale, product.privacyHref.replace(/^\//, ""))
  : null;
const supportHref = product.supportHref
  ? getRelativeLocaleUrl(locale, product.supportHref.replace(/^\//, ""))
  : null;
---

{
  (privacyHref || supportHref) && (
    <p class:list={["text-muted-foreground text-sm", className]}>
      {privacyHref && (
        <a
          href={privacyHref}
          class="hover:text-foreground underline-offset-4 hover:underline"
        >
          {t.nav.privacy}
        </a>
      )}
      {privacyHref && supportHref && <span aria-hidden="true"> · </span>}
      {supportHref && (
        <a
          href={supportHref}
          class="hover:text-foreground underline-offset-4 hover:underline"
        >
          {t.nav.support}
        </a>
      )}
    </p>
  )
}
