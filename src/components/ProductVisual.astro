---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { resolveLocale, useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  visual: "clipboard" | "jump" | "harbor";
  name: string;
  nameEn: string;
  image?: ImageMetadata;
};

const { visual, name, nameEn, image } = Astro.props;
const locale = resolveLocale(Astro.currentLocale ?? config.site.lang);
const t = useTranslations(locale);
const mock =
  locale === "en"
    ? {
        justCopied: "Just copied",
        imagePng: "Image · PNG",
        swatchFile: "swatch-12.png",
        text: "Text",
        meetingNotes: "Meeting notes…",
      }
    : {
        justCopied: "刚刚复制",
        imagePng: "图片 · PNG",
        swatchFile: "色卡 12.png",
        text: "文本",
        meetingNotes: "会议纪要要点…",
      };
const wide = visual !== "jump";
---

{
  image ? (
    <Image
      src={image}
      alt={`${name} ${t.common.preview}`}
      class:list={[
        "h-auto w-full bg-transparent",
        wide ? "max-w-xl" : "max-w-md",
      ]}
      widths={[400, 640, 800, 1120, 1400]}
      sizes={
        wide
          ? "(min-width: 1024px) 36rem, 90vw"
          : "(min-width: 1024px) 28rem, 90vw"
      }
      format="webp"
    />
  ) : (
    <div class="border-border/60 relative flex aspect-4/5 w-full max-w-sm items-end overflow-hidden rounded-[2rem] border px-6 pt-8 pb-0 shadow-[0_24px_80px_rgb(0_0_0_/_0.35)]">
      {visual === "clipboard" ? (
        <div class="absolute inset-0 bg-linear-to-b from-violet-500/90 via-indigo-500/70 to-slate-950" />
      ) : (
        <div class="absolute inset-0 bg-linear-to-b from-emerald-400/90 via-green-600/70 to-slate-950" />
      )}
      <div
        class="pointer-events-none absolute inset-0 opacity-20"
        style="background-image: repeating-linear-gradient(135deg, transparent, transparent 12px, white 12px, white 13px);"
      />

      <div class="relative z-10 w-full">
        <p class="text-sm tracking-widest text-white/70 uppercase">{nameEn}</p>
        <h3 class="mt-1 text-3xl font-semibold text-white">{name}</h3>

        {visual === "clipboard" ? (
          <div class="mt-8 space-y-2 pb-8">
            <div class="rounded-2xl bg-white/95 p-4 text-zinc-900 shadow-lg">
              <p class="text-xs text-zinc-500">{mock.justCopied}</p>
              <p class="mt-1 font-medium">https://xingyao.app</p>
            </div>
            <div class="rounded-2xl bg-white/80 p-4 text-zinc-800">
              <p class="text-xs text-zinc-500">{mock.imagePng}</p>
              <p class="mt-1 font-medium">{mock.swatchFile}</p>
            </div>
            <div class="rounded-2xl bg-white/60 p-4 text-zinc-700">
              <p class="text-xs text-zinc-500">{mock.text}</p>
              <p class="mt-1 font-medium">{mock.meetingNotes}</p>
            </div>
          </div>
        ) : (
          <div class="mt-10 flex flex-col items-center pb-10">
            <div class="relative grid size-40 place-items-center">
              <div class="absolute inset-0 rounded-full border-[10px] border-white/20" />
              <div class="absolute inset-0 rotate-45 rounded-full border-[10px] border-white border-b-transparent border-l-transparent" />
              <div class="text-center text-white">
                <p class="text-4xl font-semibold tabular-nums">128</p>
                <p class="text-xs tracking-widest text-white/70 uppercase">
                  jumps
                </p>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  )
}
