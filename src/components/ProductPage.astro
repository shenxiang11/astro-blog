---
import type { Product } from "@/data/products";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ProductVisual from "@/components/ProductVisual.astro";
import config from "@/config";

type Props = {
  product: Product;
};

const { product } = Astro.props;
---

<Layout
  title={`${product.name} | ${config.site.title}`}
  description={product.description}
>
  <Header />

  <main id="main-content" class="flex-1">
    <section
      class="site-layout grid items-center gap-12 pt-8 pb-16 lg:grid-cols-2 lg:pt-12 lg:pb-24"
    >
      <div>
        <p class="text-muted-foreground text-sm tracking-[0.2em] uppercase">
          {product.nameEn}
        </p>
        <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-6xl">
          {product.title}
        </h1>
        <p class="text-muted-foreground mt-5 max-w-lg text-lg leading-relaxed">
          {product.description}
        </p>
        <p class="text-muted-foreground mt-4 text-sm">
          {product.platforms.join(" · ")}
        </p>
      </div>
      <div class="flex lg:justify-end">
        <ProductVisual
          visual={product.visual}
          name={product.name}
          nameEn={product.nameEn}
        />
      </div>
    </section>

    <section class="site-layout pb-24">
      <h2 class="font-hand text-4xl">Features.</h2>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2">
        {
          product.features.map(feature => (
            <li class="border-border/80 bg-card/60 rounded-2xl border px-5 py-4">
              {feature}
            </li>
          ))
        }
      </ul>
    </section>
  </main>

  <Footer />
</Layout>
