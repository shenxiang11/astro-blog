---
import type { LocalizedProduct } from "@/data/products";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ProductVisual from "@/components/ProductVisual.astro";
import ProductFeatureList from "@/components/ProductFeatureList.astro";
import AppStoreBadge from "@/components/AppStoreBadge.astro";
import { productCovers } from "@/data/productCovers";
import IconBrandGithub from "@/assets/icons/socials/github.svg";
import { useTranslations } from "@/i18n";
import config from "@/config";
import "@/styles/tiaotiao.css";

type Props = {
  product: LocalizedProduct;
};

const { product } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const privacyHref = getRelativeLocaleUrl(
  locale,
  product.privacyHref.replace(/^\//, "")
);
const supportHref = getRelativeLocaleUrl(
  locale,
  product.supportHref.replace(/^\//, "")
);
---

<Layout
  title={`${product.name} | ${config.site.title}`}
  description={product.description}
>
  <Header />

  <main id="main-content" class="flex-1">
    <section
      class="site-layout grid items-center gap-12 pt-8 pb-16 lg:grid-cols-2 lg:pt-12 lg:pb-24"
    >
      <div>
        <p class="text-muted-foreground text-sm tracking-[0.2em] uppercase">
          {product.nameEn}
        </p>
        <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-6xl">
          {product.title}
        </h1>
        <p class="text-muted-foreground mt-5 max-w-lg text-lg leading-relaxed">
          {product.description}
        </p>
        <ProductFeatureList features={product.features} />
        <p class="text-muted-foreground mt-4 text-sm">
          {product.platforms.join(" · ")}
        </p>
        {
          product.downloadUrl && (
            <a
              href={product.downloadUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-foreground text-background mt-8 inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-medium"
            >
              <IconBrandGithub class="size-4" />
              {t.store.download}
            </a>
          )
        }
        {
          "appStoreUrl" in product && (
            <AppStoreBadge href={product.appStoreUrl} />
          )
        }
        <p class="text-muted-foreground mt-6 text-sm">
          <a
            href={privacyHref}
            class="hover:text-foreground underline-offset-4 hover:underline"
          >
            {t.nav.privacy}
          </a>
          <span aria-hidden="true"> · </span>
          <a
            href={supportHref}
            class="hover:text-foreground underline-offset-4 hover:underline"
          >
            {t.nav.support}
          </a>
        </p>
      </div>
      <div class="flex lg:justify-end">
        <ProductVisual
          visual={product.visual}
          name={product.name}
          nameEn={product.nameEn}
          image={productCovers[product.id]}
        />
      </div>
    </section>
  </main>

  <Footer />
</Layout>
