---
import type { Library } from "@/data/libraries";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconBrandGithub from "@/assets/icons/socials/github.svg";
import config from "@/config";

type Props = {
  library: Library;
};

const { library } = Astro.props;
const { name, description, platforms, repo, article, demo } = library;
const locale = Astro.currentLocale ?? config.site.lang;
const articleHref = article
  ? getRelativeLocaleUrl(locale, article)
  : undefined;
const isExternalDemo = Boolean(demo?.startsWith("https://") || demo?.startsWith("http://"));
const demoHref = demo
  ? isExternalDemo
    ? demo
    : getRelativeLocaleUrl(locale, demo)
  : undefined;
---

<li class="border-border/50 border-b py-8 last:border-b-0">
  <div class="grid gap-2 sm:grid-cols-[7.5rem_minmax(0,1fr)] sm:gap-10">
    <p class="text-muted-foreground text-sm sm:pt-1.5">
      {platforms.join(" · ")}
    </p>
    <div>
      <h2 class="text-xl font-semibold tracking-tight sm:text-2xl">
        <a
          href={repo}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-muted-foreground"
        >
          {name}
        </a>
      </h2>
      <p class="text-muted-foreground mt-2 text-[15px] leading-relaxed">
        {description}
      </p>
      <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
        <a
          href={repo}
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted-foreground hover:text-foreground inline-flex items-center gap-1.5 transition-colors"
        >
          <IconBrandGithub class="size-3.5" />
          GitHub
        </a>
        {
          demoHref && (
            <a
              href={demoHref}
              class="text-muted-foreground hover:text-foreground transition-colors"
              target={isExternalDemo ? "_blank" : undefined}
              rel={isExternalDemo ? "noopener noreferrer" : undefined}
            >
              演示
            </a>
          )
        }
        {
          articleHref && (
            <a
              href={articleHref}
              class="text-muted-foreground hover:text-foreground transition-colors"
            >
              笔记
            </a>
          )
        }
      </p>
    </div>
  </div>
</li>
