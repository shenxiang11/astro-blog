---
import type { DemoKind } from "@/data/demoPreviews";
import { Image } from "astro:assets";
import LogoXingyao from "@/assets/icons/LogoXingyao.svg";
import cardFront from "@/assets/lanyard/card-front.png";
import { S65_SPEED_PATH, S65_SPEED_VIEWBOX } from "@/components/s65/speedPath";

type Props = {
  kind: DemoKind;
};

const { kind } = Astro.props;
---

{
  kind === "s65" && (
    <div class="demo-s65" aria-hidden="true">
      <span class="demo-s65-glow" />
      <svg class="demo-s65-svg" viewBox={S65_SPEED_VIEWBOX} fill="none">
        <path class="demo-s65-bg" d={S65_SPEED_PATH} />
        <path class="demo-s65-fill" d={S65_SPEED_PATH} />
        <defs>
          <linearGradient
            id="demo-s65-shine"
            x1="0%"
            y1="50%"
            x2="100%"
            y2="50%"
            gradientUnits="objectBoundingBox"
          >
            <stop offset="0" stop-color="#25d6e9" stop-opacity="0" />
            <stop offset="0.38" stop-color="#ffffff" stop-opacity="0.55" />
            <stop offset="0.52" stop-color="#ffffff" stop-opacity="1" />
            <stop offset="0.66" stop-color="#7af0ff" stop-opacity="0.55" />
            <stop offset="1" stop-color="#25d6e9" stop-opacity="0" />
            <animateTransform
              attributeName="gradientTransform"
              type="translate"
              values="-1 0; 1 0"
              dur="2.6s"
              repeatCount="indefinite"
            />
          </linearGradient>
        </defs>
      </svg>
    </div>
  )
}

{
  kind === "vapkit" && (
    <div class="demo-vapkit" aria-hidden="true">
      <span class="demo-vapkit-glow" />
      <span class="demo-vapkit-rocket">🚀</span>
      <span class="demo-vapkit-chip">超级火箭</span>
    </div>
  )
}

{
  kind === "lanyard" && (
    <div class="demo-lanyard" aria-hidden="true">
      <div class="demo-lanyard-hang">
        <span class="demo-lanyard-strap">
          <LogoXingyao class="demo-lanyard-mark" />
          <LogoXingyao class="demo-lanyard-mark" />
        </span>
        <span class="demo-lanyard-clip" />
        <div class="demo-lanyard-card">
          <Image src={cardFront} alt="" class="demo-lanyard-face" />
        </div>
      </div>
    </div>
  )
}

{
  kind === "text-animations" && (
    <div class="demo-text-anim" aria-hidden="true">
      <span>T</span>
      <span>e</span>
      <span>x</span>
      <span>t</span>
    </div>
  )
}

{
  kind === "height-slider" && (
    <div class="demo-height" aria-hidden="true">
      <span class="demo-height-value">175</span>
      <span class="demo-height-unit">cm</span>
      <div class="demo-height-ruler">
        <span class="demo-height-pointer" />
        <span class="demo-height-ticks" />
      </div>
    </div>
  )
}

{
  kind === "weight-slider" && (
    <div class="demo-weight" aria-hidden="true">
      <span class="demo-weight-value">60</span>
      <span class="demo-weight-unit">kg</span>
      <div class="demo-weight-arc">
        <span class="demo-weight-pointer" />
        <span class="demo-weight-needle" />
        <svg class="demo-weight-svg" viewBox="0 0 320 100">
          {Array.from({ length: 21 }, (_, i) => {
            const angle = ((i - 10) * 7 - 90) * (Math.PI / 180);
            const radius = 280;
            const cx = 160;
            const cy = 292;
            const len = i % 5 === 0 ? 18 : 10;
            return (
              <line
                x1={cx + radius * Math.cos(angle)}
                y1={cy + radius * Math.sin(angle)}
                x2={cx + (radius - len) * Math.cos(angle)}
                y2={cy + (radius - len) * Math.sin(angle)}
              />
            );
          })}
        </svg>
      </div>
    </div>
  )
}

{
  kind === "elastic-slider" && (
    <div class="demo-elastic" aria-hidden="true">
      <span class="demo-elastic-value">50</span>
      <div class="demo-elastic-row">
        <svg class="demo-elastic-icon" viewBox="0 0 24 24" fill="currentColor">
          <path d="M5 9v6h4l5 5V4L9 9H5zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z" />
        </svg>
        <div class="demo-elastic-track">
          <span class="demo-elastic-range" />
        </div>
        <svg class="demo-elastic-icon" viewBox="0 0 24 24" fill="currentColor">
          <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z" />
        </svg>
      </div>
    </div>
  )
}
