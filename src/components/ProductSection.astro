---
import type { Product } from "@/data/products";
import { getRelativeLocaleUrl } from "astro:i18n";
import ProductVisual from "./ProductVisual.astro";
import ProductFeatureList from "./ProductFeatureList.astro";
import { productCovers } from "@/data/productCovers";
import IconBrandGithub from "@/assets/icons/socials/github.svg";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  product: Product;
  flip?: boolean;
};

const { product, flip = false } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const href = getRelativeLocaleUrl(locale, product.href.replace(/^\//, ""));
const cover = productCovers[product.id];
---

<section class="site-layout py-16 sm:py-24" id={product.id}>
  <div
    class:list={[
      "grid items-center gap-10 lg:grid-cols-2 lg:gap-16",
      { "lg:[&>*:first-child]:order-2": flip },
    ]}
  >
    <div>
      <p class="text-muted-foreground text-sm tracking-[0.2em] uppercase">
        {product.kicker}
      </p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-5xl">
        {product.title}
      </h2>
      <p class="text-muted-foreground mt-4 max-w-md text-base leading-relaxed">
        {product.description}
      </p>
      <ProductFeatureList features={product.features} />
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={href}
          class="bg-foreground text-background rounded-full px-5 py-2.5 text-sm font-medium"
        >
          了解更多
        </a>
        {
          product.downloadUrl && (
            <a
              href={product.downloadUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="border-border text-foreground inline-flex items-center gap-2 rounded-full border px-5 py-2.5 text-sm font-medium"
            >
              <IconBrandGithub class="size-4" />
              {t.store.download}
            </a>
          )
        }
      </div>
    </div>
    <div class:list={["flex", flip ? "lg:justify-start" : "lg:justify-end"]}>
      <ProductVisual
        visual={product.visual}
        name={product.name}
        nameEn={product.nameEn}
        image={cover}
      />
    </div>
  </div>
</section>
