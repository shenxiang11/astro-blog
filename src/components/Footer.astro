---
import type { HTMLAttributes } from "astro/types";
import config from "@/config";
import { useTranslations } from "@/i18n";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
const t = useTranslations(Astro.currentLocale ?? config.site.lang);
const currentYear = new Date().getFullYear();
---

<footer
  class:list={["site-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="border-border/70 text-muted-foreground flex justify-center border-t py-8 text-sm"
  >
    <span>
      {t.footer.copyright} &#169; {currentYear}
      {config.site.author}
    </span>
  </div>
</footer>
