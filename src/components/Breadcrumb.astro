---
import { getRelativeLocaleUrl } from "astro:i18n";
import { stripBase, stripLocale } from "@/utils/withBase";
import { tplStr, useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  class?: string;
  currentLabel?: string;
};

const { class: className, currentLabel } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Strip base prefix and trailing slash, then locale prefix so segments
// reflect the logical page path only.
const pathWithoutBase = stripBase(Astro.url.pathname).replace(/\/+$/, "");
const currentUrlPath = stripLocale(pathWithoutBase, locale);

// Get url array from path
// eg: /tags/tailwindcss => ['tags', 'tailwindcss']
const breadcrumbList = currentUrlPath.split("/").slice(1).filter(Boolean);

const decodeSegment = (value: string) => {
  try {
    return decodeURIComponent(value);
  } catch {
    return value;
  }
};

const navLabels: Record<string, string> = {
  posts: t.nav.posts,
  demos: t.nav.demos,
  libraries: t.nav.libraries,
  tags: t.nav.tags,
  about: t.nav.about,
  privacy: t.nav.privacy,
  support: t.nav.support,
  archives: t.nav.archives,
  search: t.nav.search,
  tiaotiao: "跳跳",
  miaotie: "妙贴",
};

const pageCrumb = (n: string | number) =>
  tplStr(t.pagination.pageWithNumber, { n });

// Home > Posts > [page]  →  Posts, or Posts / page N
// Home > Posts > [slug]  →  keep both (article title via currentLabel)
if (breadcrumbList[0] === "posts") {
  const second = breadcrumbList[1];
  if (!second) {
    breadcrumbList.length = 0;
    breadcrumbList.push("posts");
  } else if (/^\d+$/.test(second)) {
    breadcrumbList.length = 0;
    breadcrumbList.push("posts");
    if (second !== "1") {
      breadcrumbList.push(pageCrumb(second));
    }
  }
}

// Home > Tags > [tag] > [page]  →  tag, or tag (page N)
if (breadcrumbList[0] === "tags" && !isNaN(Number(breadcrumbList[2]))) {
  breadcrumbList.splice(
    1,
    3,
    `${decodeSegment(breadcrumbList[1])} ${
      Number(breadcrumbList[2]) === 1 ? "" : `（${pageCrumb(breadcrumbList[2])}）`
    }`
  );
}

const crumbHref = (index: number) => {
  const segments = breadcrumbList.slice(0, index + 1);
  // Numbered post pages are not real path segments.
  if (breadcrumbList[0] === "posts") {
    return getRelativeLocaleUrl(locale, "posts");
  }
  return getRelativeLocaleUrl(locale, segments.join("/"));
};
---

<nav
  class:list={[
    "text-muted-foreground text-sm",
    className ?? "app-layout mb-1",
  ]}
  aria-label="breadcrumb"
>
  <ol class="flex flex-wrap items-center gap-x-2">
    <li class="flex items-center gap-x-2">
      <a href={getRelativeLocaleUrl(locale, "")} class="hover:text-foreground">
        {t.nav.home}
      </a>
      {
        breadcrumbList.length > 0 && (
          <span aria-hidden="true" class="opacity-40">
            /
          </span>
        )
      }
    </li>
    {
      breadcrumbList.map((breadcrumb, index) =>
        index + 1 === breadcrumbList.length ? (
          <li>
            <span class="text-foreground/70 line-clamp-1" aria-current="page">
              {currentLabel ?? navLabels[breadcrumb] ?? decodeSegment(breadcrumb)}
            </span>
          </li>
        ) : (
          <li class="flex items-center gap-x-2">
            <a href={crumbHref(index)} class="hover:text-foreground">
              {navLabels[breadcrumb] ?? decodeSegment(breadcrumb)}
            </a>
            <span aria-hidden="true" class="opacity-40">
              /
            </span>
          </li>
        )
      )
    }
  </ol>
</nav>
