---
import { getPushTesterPreviews } from "@/data/pushtesterPreviews";
import { useTranslations } from "@/i18n";
import config from "@/config";
import "@/styles/pushtester.css";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const preview = getPushTesterPreviews(locale)[0];
---

{
  preview && (
    <section class="pushtester-shots site-layout" aria-label={t.common.preview}>
      <figure class="pushtester-shot">
        <img
          src={preview.src.src}
          alt={preview.alt}
          width={preview.src.width}
          height={preview.src.height}
        />
        <figcaption>{preview.alt}</figcaption>
      </figure>
    </section>
  )
}
