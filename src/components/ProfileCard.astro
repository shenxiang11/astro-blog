---
import { profile } from "@/data/profile";
import LogoXingyao from "@/assets/icons/LogoXingyao.svg";
---

<div
  class="relative flex min-h-[28rem] w-full max-w-md flex-col overflow-hidden rounded-[2rem] px-7 pt-8 pb-0 shadow-[0_30px_80px_rgb(0_0_0_/_0.4)] sm:min-h-[32rem]"
>
  <div
    class="absolute inset-0 bg-linear-to-b from-[#e11d48] via-[#fb7185] via-45% to-[#7dd3fc]"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.18]"
    style="background-image: repeating-linear-gradient(-32deg, transparent, transparent 18px, white 18px, white 19px);"
  >
  </div>

  <div class="relative z-10">
    <h2 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl">
      {profile.name}
    </h2>
    <p class="mt-1 text-sm text-white/80">{profile.role}</p>
  </div>

  <div class="relative z-10 mt-auto grid h-56 place-items-center sm:h-72">
    <LogoXingyao class="size-28 text-white/90 sm:size-36" aria-hidden="true" />
  </div>
</div>
